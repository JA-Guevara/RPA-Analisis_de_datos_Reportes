# ==============================================================================
# CONFIGURACION DE ENTORNO - BOT ITACAMBA REPORTES (ELT)
# ==============================================================================

# BASE DE DATOS SQL SERVER
DB_SERVER=192.168.100.75
DB_PORT=1433
DB_NAME=Reportes_Itacamba
DB_USER=bot_reportes_itacamba
DB_PASSWORD=
DB_DRIVER=SQL Server
DB_TRUST_CERT=yes

# RUTAS DE ARCHIVOS (Dejar vacio para autodeteccion de OneDrive - Tecorp\Documentos ITACAMBA\Archivos)
DATA_PATH=
EXPORT_PATH=

# CORREO (Opcional para notificaciones)
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# ==============================================================================
# CONFIGURACION SAP GUI (AUTOMATIZACION RPA)
# ==============================================================================
SAP_LOGON_PATH=C:\Program Files (x86)\SAP\FrontEnd\SAPgui\saplogon.exe
SAP_PROCESS=saplogon.exe
SAP_WINDOW_TITLE=SAP Logon 770
SAP_AMBIENT=# -E05 - S4 RISE - Produção SSO
SAP_MANDANTE=300
SAP_SISTEMA=E05
SAP_IDIOMA=ES
SAP_USER=
SAP_PASSWORD=
