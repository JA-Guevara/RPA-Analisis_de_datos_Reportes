# ==============================================================================
# CONFIGURACION DE ENTORNO - BOT ITACAMBA REPORTES (ELT)
# ==============================================================================

# BASE DE DATOS SQL SERVER
DB_SERVER=
DB_PORT=1433
DB_NAME=Reportes_Itacamba
DB_USER=
DB_PASSWORD=
DB_DRIVER=SQL Server
DB_TRUST_CERT=yes

# RUTAS SEGMENTADAS (OBLIGATORIAS EN .ENV - SIN RUTAS FIJAS EN CODIGO)
PATH_INSUMOS_FIJOS=
PATH_INSUMOS_DINAMICOS=
PATH_REPORTES_SALIDA=
# Opcional (por defecto storage/logs)
PATH_LOGS_STORAGE=

# ==============================================================================
# CONFIGURACION SAP GUI (SCRIPTING COM)
# ==============================================================================
SAP_LOGON_PATH=C:\Program Files (x86)\SAP\FrontEnd\SAPgui\saplogon.exe
SAP_AMBIENT=# -E05 - S4 RISE - Produção SSO
SAP_SISTEMA=E05
SAP_MANDANTE=300
SAP_USER=
SAP_PASSWORD=
SAP_IDIOMA=ES

# ==============================================================================
# NOTIFICACIONES DE ERROR (POWER AUTOMATE WEBHOOK)
# ==============================================================================
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_KEY=
MAIL_WEBHOOK_TIMEOUT=30
MAIL_SOPORTE=
MAIL_COPIA_SOPORTE=
MAIL_GENERAL=grupocrc@itacamba.com
MAIL_COPIA_GENERAL=ja.guevara@conecta.com.bo
MAIL_ALERT_ON_ERROR=yes
